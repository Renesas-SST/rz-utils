From 7c7732da43b7dfe8b52e68442dd33abab05fd590 Mon Sep 17 00:00:00 2001
From: Tien Nguyen <tien.nguyen.uh@renesas.com>
Date: Fri, 22 May 2026 07:58:01 +0000
Subject: [PATCH 2/2] drp: update remove callbacks for Linux 6.18

Linux 6.18 expects platform driver remove callbacks to return void.

Update the DRP remove callbacks to match the new prototype by
changing the return type from int to void and dropping the unused return
values.

No functional change.

Upstream-Status: Pending

Signed-off-by: Tien Nguyen <tien.nguyen.uh@renesas.com>
---
 drivers/drp/drp-if.c | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/drivers/drp/drp-if.c b/drivers/drp/drp-if.c
index 8249bebebe18..df81ea4f9afc 100644
--- a/drivers/drp/drp-if.c
+++ b/drivers/drp/drp-if.c
@@ -134,7 +134,7 @@
 
 /* A function called from the kernel */
 static int drp_probe(struct platform_device *pdev);
-static int drp_remove(struct platform_device *pdev);
+static void drp_remove(struct platform_device *pdev);
 static int drp_open(struct inode *inode, struct file *file);
 static int drp_close(struct inode *inode, struct file *file);
 static int drp_flush(struct file *file, fl_owner_t id);
@@ -324,12 +324,10 @@ static int drp_probe(struct platform_device *pdev)
     return ret;
 }
 
-static int drp_remove(struct platform_device *pdev)
+static void drp_remove(struct platform_device *pdev)
 {
     drp_unregist_driver();
     drp_unregist_device();
-
-    return 0;
 }
 
 static int drp_open(struct inode *inode, struct file *file)
-- 
