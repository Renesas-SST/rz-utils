+static void reg_bit_clear(volatile void __iomem *reg_address, uint32_t bit)
+{
+    uint32_t tmp_reg;
+
+    DRPAI_DEBUG_PRINT("start.\n");
+
+    /* Read register value */
+    tmp_reg = ioread32(reg_address);
+    /* Clear the target bit */
+    tmp_reg = tmp_reg & (~bit);
+
+    iowrite32(tmp_reg, reg_address);
+
+    DRPAI_DEBUG_PRINT("end.\n");
+}
