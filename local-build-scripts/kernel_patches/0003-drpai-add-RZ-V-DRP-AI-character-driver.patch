+    int flag_drpai_shared_init = -1;
+#endif
+
+    DRPAI_DEBUG_PRINT("start.\n");
+
+    if(unlikely(down_timeout(&priv->sem, MAX_SEM_TIMEOUT)))
+    {
+        result = -ETIMEDOUT;
+        goto end;
+    }
+    DRPAI_DEBUG_PRINT(" \n");
+    /* Check NULL */
+    if (0 == arg)
+    {
+        result = -EINVAL;
+        goto end;
+    }
+
+#ifdef ENABLE_DRP_SUPPORT_SHARED_MEMORY
+    /* DRPFLAG_DRP_LOCK is set */
+    flag_drpai_shared_used = R_DRPAI_LockDrpaiContStatus(drpai_shared_exclusion,
+                                                         &shared_mem_lock,
+                                                         PROCESS_CONTEXT,
+                                                         DRPFLAG_DRPAI_LOCK);
+    if(-1 == flag_drpai_shared_used)
+    {
+        result = -EINPROGRESS;
+        goto end;
+    }
+    if( 0 != flag_drpai_shared_used)
+    {
+        result = -EADDRNOTAVAIL;
+        goto end;
+    }
+#endif
+
+    /* Get the internal state of DRP-AI */
+    spin_lock_irqsave(&priv->lock, flags);
+#ifdef ENABLE_DRP_SUPPORT_SHARED_MEMORY
+    flag_drpai_shared_init = R_DRPAI_IsDrpaiHwStatusActive(drpai_shared_exclusion);
