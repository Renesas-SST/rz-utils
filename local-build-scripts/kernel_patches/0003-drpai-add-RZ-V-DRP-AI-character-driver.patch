+        DRPAI_DEBUG_PRINT("[ioctl(DRPAI_WRITE_CPG_REG)]\n");
+        result = drpai_ioctl_write_cpg_reg(filp, cmd, arg);
+        break;
+    default:
+        DRPAI_DEBUG_PRINT(KERN_WARNING "unsupported command %d\n", cmd);
+        result = -EFAULT;
+        break;
+    }
+    goto end;
+
+end:
+    return result;
