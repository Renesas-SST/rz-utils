+{
+    DRPAI_DEBUG_PRINT("start.\n");
+
+#if 1 /* for CPG direct access (preliminary) */
+    iounmap(cpg_base_address);
+#endif
+
+    DRPAI_DEBUG_PRINT("end.\n");
