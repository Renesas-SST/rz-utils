+
+    if (0 != tbl)
+    {
+        enable_addr_relocatable_func(drp_base_addr, 0, tbl);
+    }
+    else
+    {
+        ret = R_DRPAI_ERR_INVALID_ARG;
+    }
+
+    return ret;
+}
