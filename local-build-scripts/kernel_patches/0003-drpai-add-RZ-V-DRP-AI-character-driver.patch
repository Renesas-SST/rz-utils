+ *    echo "CONFIG_DRP_SUPPORT_SHARED_MEMORY" | md5sum
+ */
+#define INIT_HASH_TOP_VAL                   (0x9bca83cf9c5b7f1e)
+#define INIT_HASH_BOTTOM_VAL                (0xa30b890ea28c78e7)
