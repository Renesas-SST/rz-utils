+
+static int32_t dma_stop(addr_t dmactl_addr)
+{
+    int32_t ret = -1;
+    uint32_t loop;
+
+    iowrite8(0x00, dmactl_addr + 0x2);
+    iowrite8(0x00, dmactl_addr + 0x0);
+
+    loop = 0;
+    while ((100 > loop) && (0 != ret))
+    {
+        if (0 == check_reg(dmactl_addr, 0x00080000, 0x00000002, 0x00080000))
+        {
+            ret = 0;
+            break;
+        }
+        udelay(1);
+        loop++;
+    }
+
+    loop = 0;
+    while ((100 > loop) && (0 != ret))
+    {
+        if (0 == check_reg(dmactl_addr, 0x00080000, 0x00000002, 0x00080000))
+        {
+            ret = 0;
+            break;
+        }
+        usleep_range(100, 200);
+        loop++;
+    }
+
+    return ret;
+}
