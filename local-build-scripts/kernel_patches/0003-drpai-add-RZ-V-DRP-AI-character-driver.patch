+    tbl_num = (0 == (act_size & DRPAI_MAX_24BIT)) ? tbl_num : tbl_num + 1;
+    if (DRPAI_ADRCONV_TBL_NUM < (page + tbl_num))
+    {
+        result = -ENOMEM;
+        goto end;
