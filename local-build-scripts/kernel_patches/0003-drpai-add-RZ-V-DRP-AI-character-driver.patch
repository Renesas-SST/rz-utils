+void    R_V2H_DRPAI_AIMAC_Errint(addr_t drp_base_addr, addr_t aimac_base_addr, int32_t ch);
+void    R_V2H_DRPAI_Status(addr_t drp_base_addr, addr_t aimac_base_addr, int32_t ch, uint32_t* reserved);
+int32_t R_DRPAI_DRP_RegRead(addr_t drp_base_addr, uint32_t offset, uint32_t* pvalue);
