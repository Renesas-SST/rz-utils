+        result = drpai_ioctl_set_extra_area(filp, cmd, arg);
+        break;
+/* V2L conditional compilation */
+#if 0
+    case DRPAI_SET_SEQ:
+        DRPAI_DEBUG_PRINT("[ioctl(DRPAI_SET_SEQ)]\n");
+        result = drpai_ioctl_set_seq(filp, cmd, arg);
