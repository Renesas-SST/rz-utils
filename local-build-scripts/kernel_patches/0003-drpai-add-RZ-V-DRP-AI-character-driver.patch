+static int32_t stop_drp_dmacw(addr_t drp_base_addr)
+{
+    addr_t dmactl_addr = drp_base_addr + STP_IDIF_BADDR + IDIF_DMACTLCW_REG;
+
+    iowrite8(0x00, dmactl_addr);
+
+    return loop_w(dmactl_addr, 0x00000000, 0xFFFFFFFD);
+}
