+{
+    int32_t ret = R_DRPAI_SUCCESS;
+
+    if ((1 <= divfix) && (127 >= divfix))
+    {
+        set_aimac_freq(aimac_base_addr, divfix);
+    }
+    else
+    {
+        ret = R_DRPAI_ERR_INVALID_ARG;
+    }
