+        goto end;
+    }
+
+    /* Check status */
+    if (DRPAI_STATUS_RUN == local_drpai_status.status)
+    {
+        result = -EBUSY;
+        goto end;
+    }
+
+    /* Check DRP-AI H/W error */
+    if ((DRPAI_ERRINFO_DRP_ERR == local_drpai_status.err) || (DRPAI_ERRINFO_AIMAC_ERR == local_drpai_status.err))
+    {
+        result = -EIO;
+        goto end;
+    }
+
+    DRPAI_DEBUG_WAIT();
+    goto end;
+end:
+#ifdef ENABLE_DRP_SUPPORT_SHARED_MEMORY
+    if(0 == flag_drpai_shared_used)
+    {
+        R_DRPAI_UnlockDrpaiContStatus(drpai_shared_exclusion,
+                                      &shared_mem_lock,
+                                      PROCESS_CONTEXT,
+                                      DRPFLAG_DRPAI_LOCK);
+    }
+#endif
+    if(-ETIMEDOUT != result)
+    {
+        up(&priv->sem);
+    }
+    DRPAI_DEBUG_PRINT("end.\n");
+
+    return result;
