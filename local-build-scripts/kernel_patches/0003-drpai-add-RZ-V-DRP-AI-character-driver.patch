@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * Driver for the Renesas RZ/V2H, RZ/V2N DRP-AI unit
+ *
+ * Copyright (C) 2024 Renesas Electronics Corporation
+ *
