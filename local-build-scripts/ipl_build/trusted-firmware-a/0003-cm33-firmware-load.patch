 static void cpg_ctrl_clkrst(CPG_SETUP_DATA const *array, uint32_t num, uint32_t ip_control_mask)
 {
 	int i;
@@ -1779,6 +1842,10 @@ static void cpg_mstop_setup(void)
 										| CPG_BUS_4_MSTOP_XSPI
 										| CPG_BUS_4_MSTOP_SECURE_IP_P0
 										| CPG_BUS_4_MSTOP_SECURE_IP_P1
+#if PLAT_M33_BOOT_SUPPORT
